00000            REC     START   0    
00000  4B216F            JSUB    SINIT    
00003  4B2035    LOOP    JSUB    READ    . reads the value
00006  7503E8            LDT     #1000    
00009  A054              COMPR   T,S    
0000B  332027            JEQ     HALT    . if value is 0 (signaling EOF) end programme
0000E  29000A            COMP    #10    . avoid double newlines
00011  332FEF            JEQ     LOOP    
00014  03206D            LDA     NUM    . parameter for recursive function will be in A
00017  4B206D            JSUB    CALC    . else calculate value
0001A  0F2067            STA     NUM    . result is stored in reg A
0001D  4B2092            JSUB    SETL0    . I have a problem if last digit is 0, so I need to set a flag if it is
00020  4B20D5            JSUB    RVRSE    . reverse NUM for easier print
00023  4B2103            JSUB    WRITE    . and write value
00026  0320C9            LDA     LAST0    . check I we need to print extra 0
00029  290000            COMP    #0    
0002C  37211F            JGT     PRINT0    
0002F  4B2137    PNL     JSUB    PRNTNL    . print new line
00032  3F2FCE            J       LOOP    . repeat until 0
                  
                  
00035  3F2FFD    HALT    J       HALT    
                  
00038  4F0000    RET     RSUB        
                  
                  . rutina za branje
0003B  E100FA    READ    TD      #250    
0003E  D900FA            RD      #250    . preberi prvi char
00041  29000A            COMP    #10    . primerjamo z \n
00044  332FF1            JEQ     RET    
00047  29000D            COMP    #13    . primerjamo z carriage return
0004A  332FEB            JEQ     RET    
0004D  1D0030            SUB     #48    
00050  290000            COMP    #0    . če je 0 pomeni konec programa
00053  332028            JEQ     ENDPRG    
00056  0F202B            STA     NUM    . shranimo
00059  E100FA    RDLOOP  TD      #250    
0005C  D900FA            RD      #250    . preberemo naslednji bit
0005F  29000A            COMP    #10    . primerjamo z \n
00062  332FD3            JEQ     RET    
00065  29000D            COMP    #13    . primerjamo z carriage return
00068  332FCD            JEQ     RET    
0006B  1D0030            SUB     #48    
0006E  AC03              RMO     A,B    
00070  032011            LDA     NUM    
00073  21000A            MUL     #10    
00076  9030              ADDR    B,A    . zmnožimo in seštejemo število
00078  0F2009            STA     NUM    . shranimo ga nazaj v NUM
0007B  3F2FDB            J       RDLOOP    . ponovimo
                  
                  
0007E  6D03E8    ENDPRG  LDS     #1000    
00081  4F0000            RSUB        
                  
                  
                  . podatki za branje
00084  000000    NUM     RESW    1    
                  
                  . rutina za račun
00087  16211C    CALC    STL     @STKP    
0008A  4B20F5            JSUB    SPUSH    
0008D  7A2116            STB     @STKP    
00090  4B20EF            JSUB    SPUSH    
                  
00093  290002            COMP    #2    
00096  3B200A            JLT     RETCLC    
00099  AC03              RMO     A,B    
0009B  1D0001            SUB     #1    
0009E  4B2FE6            JSUB    CALC    
000A1  9830              MULR    B,A    
                  
000A3  4B20EE    RETCLC  JSUB    SPOP    
000A6  6A20FD            LDB     @STKP    
000A9  4B20E8            JSUB    SPOP    
000AC  0A20F7            LDL     @STKP    
000AF  3F2F86            J       RET    
                  
                  
                  
                  . rutina za preverjanje zadnje števke
000B2  010000    SETL0   LDA     #0    
000B5  0F203A            STA     LAST0    
000B8  032FC9            LDA     NUM    
